# Where the data tree lives. Defaults to ./data next to the checkout; on the
# lab server this points at /Data7/luyx/XIST-KB/data so Parquet and PDFs stay
# outside the git working tree.
XIST_KB_DATA=

# Anthropic API key, only needed for LLM annotation and the /ask endpoint.
ANTHROPIC_API_KEY=

# API access. Leave both empty to disable auth (local development only).
XIST_KB_API_KEY=
XIST_KB_ALLOWED_NETS=

# Crossref asks for a contact address in bulk requests.
CROSSREF_MAILTO=
